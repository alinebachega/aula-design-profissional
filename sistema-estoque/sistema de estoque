#SISTEMA DE ESTOQUE QUE CONTROLA RETIRADA DE PRODUTOS E CONSULTA ESTOQUE E O HISTORICO DE RETIRADAS.
#SORTEIA UM GANHADOR APOS ENCERAR A INTERACAO COM O PROGRAMA.

import random

estoque = {
    "mouse": 10,
    "monitor": 5,
    "gabinete": 15,
    "placa de video": 4,
    "ssd": 15,
    "teclado": 20,
    "headset": 5,
    "mousepad": 25,
    "microfone": 10,
    "webcam": 5,
    "water cooler": 5,
}

historico = []
prosseguir_opcao = 0
LIMITE_BAIXO = 5

def ler_numero(msg):
    try:
        valor = int(input(msg))
        if valor <= 0:
            print('Digite um número maior que zero.')
            return None
        return valor
    except ValueError:
        print('Valor inválido, digite apenas números.')
        return None

def estoque_baixo():
    print('\n--- ALERTA DE ESTOQUE BAIXO ---')
    baixos = [(p, q) for p, q in estoque.items() if q <= LIMITE_BAIXO]
    if not baixos:
        print('Nenhum produto com estoque baixo. Tudo certo! ✅')
    for p, q in baixos:
        if q == 0:
            print(f'🔴 {p}: ESGOTADO')
        else:
            print(f'⚠️ {p}: apenas {q} unidade(s)')

def repor_estoque():
    print('\n--- REPOSIÇÃO DE ESTOQUE ---')
    produto = input('Qual produto deseja repor? ').lower()
    if produto not in estoque:
        print(f"Produto '{produto}' não encontrado. Use a opção de cadastrar produto novo.")
        return
    qtd = ler_numero(f'Quantas unidades de "{produto}" chegaram? ')
    if qtd:
        estoque[produto] += qtd
        print(f"Reposição feita! Estoque de '{produto}': {estoque[produto]}")

def cadastrar_produto():
    print('\n--- CADASTRAR PRODUTO NOVO ---')
    produto = input('Nome do produto: ').lower().strip()
    if produto == '':
        print('O nome não pode ficar vazio.')
    elif produto in estoque:
        print('Esse produto já existe! Use a opção de repor estoque.')
    else:
        qtd = ler_numero('Quantidade inicial: ')
        if qtd:
            estoque[produto] = qtd
            print(f"Produto '{produto}' cadastrado com {qtd} unidade(s)!")

def buscar_produto():
    print('\n--- BUSCAR PRODUTO ---')
    termo = input('Digite parte do nome: ').lower().strip()
    achados = {p: q for p, q in estoque.items() if termo in p}
    if not achados:
        print('Nenhum produto encontrado.')
    for p, q in achados.items():
        print(f'Produto: {p} | Quantidade: {q}')

def relatorio():
    print('\n===== RELATÓRIO DO ESTOQUE =====')
    print(f'Produtos cadastrados: {len(estoque)}')
    print(f'Total de unidades em estoque: {sum(estoque.values())}')

    mais = max(estoque, key=estoque.get)
    menos = min(estoque, key=estoque.get)
    print(f'Maior estoque: {mais} ({estoque[mais]} un.)')
    print(f'Menor estoque: {menos} ({estoque[menos]} un.)')

    retiradas = {}
    for i in range(0, len(historico), 2):
        item, qtd = historico[i], historico[i + 1]
        retiradas[item] = retiradas.get(item, 0) + qtd

    if retiradas:
        print('\nRetiradas por produto:')
        for item, total in sorted(retiradas.items(), key=lambda x: x[1], reverse=True):
            print(f'  {item}: {total} unidade(s) retirada(s)')
        top = max(retiradas, key=retiradas.get)
        print(f'\n🏆 Produto mais retirado: {top}')
    else:
        print('\nNenhuma retirada realizada ainda.')

while True:
    print('\n===== MENU DE ESTOQUE =====')
    print('1 - Consultar estoque')
    print('2 - Retirar produto')
    print('3 - Ver histórico de retiradas')
    print('4 - Sair')
    print('5 - Repor estoque')
    print('6 - Cadastrar produto novo')
    print('7 - Buscar produto')
    print('8 - Alerta de estoque baixo')
    print('9 - Relatório do estoque')

    
    opcao = int(input('\nEscolha uma opção: '))
    if opcao == 1:
        print('\n--- ESTOQUE ATUAL ---')
        for produto, quantidade in estoque.items():
            print(f'Produto: {produto} | Quantidade: {quantidade}')
        prosseguir_opcao= int(input('\nSe você deseja prosseguir e realizar a retirada de algum produto digite 1, para sair digite 2: '))

    if prosseguir_opcao == 2:
        print('Encerrando programa...')
        break

    elif opcao == 2 or prosseguir_opcao == 1:

        item_retirar = input('\nQual item você deseja retirar do estoque? ').lower()
        if item_retirar in estoque:
            qtd_item = int(input(f'\nQuantas unidades de "{item_retirar}" deseja retirar? '))
            if qtd_item <= estoque[item_retirar]:

                historico.append(item_retirar)
                historico.append(qtd_item)

                estoque[item_retirar] = estoque[item_retirar] - qtd_item
                print(f'Retirada de {qtd_item} {item_retirar}(s)')
                print(f"Retirada realizada com sucesso! Estoque restante de '{item_retirar}': {estoque[item_retirar]}")
                retirar_novamente = input('\nVocê gostaria de retirar mais algum produto?(S/N) ').upper()

            else:
                print(f"Quantidade insuficiente! Temos apenas {estoque[item_retirar]} unidade(s) de '{item_retirar}' em estoque.")
                retirar_novamente= input('você deseja inserir novamente um produto com uma quantidade valida?(S/N) ').upper()


        else:
            print(f"Produto '{item_retirar}' não encontrado no estoque.")
            retirar_novamente= input('você deseja inserir novamente um produto?(S/N) ').upper()
        while retirar_novamente == 'S':

            item_retirar = input('\nQual item você deseja retirar do estoque? ').lower()
            if item_retirar in estoque:
                qtd_item = int(input(f'\nQuantas unidades de "{item_retirar}" deseja retirar? '))
                if qtd_item <= estoque[item_retirar]:
                    historico.append(item_retirar)
                    historico.append(qtd_item)

                    estoque[item_retirar] = estoque[item_retirar] - qtd_item
                    print(f'Retirada de {qtd_item} {item_retirar}(s)')
                    print(f"Retirada realizada com sucesso! Estoque restante de '{item_retirar}': {estoque[item_retirar]}")
                    retirar_novamente = input('\nVocê gostaria de retirar mais algum produto?(S/N) ').upper()
                else:
                    print(f"Quantidade insuficiente! Temos apenas {estoque[item_retirar]} unidade(s) de '{item_retirar}' em estoque.")
                    item_retirar = input('\nQual item você deseja retirar do estoque? ').lower()
                    retirar_novamente= input('você deseja inserir novamente um produto com uma quantidade valida?(S/N) ').upper()

            else:
                print(f"Produto '{item_retirar}' não encontrado no estoque.")
                retirar_novamente= input('você deseja inserir novamente um produto?(S/N) ').upper()

        if retirar_novamente == 'N':
            verificacao = input('voce deseja verificar o historico de itens retirados até o momento e sua quantidade?(S/N) ').upper()

            if verificacao == 'S':
                print("\n--- HISTÓRICO DE RETIRADAS ---")
                if len(historico) == 0:
                    print("Nenhuma retirada realizada ainda.")
                else:
                    print(f'Os itens retirados e suas quantidades até o momento foram: {historico}.')
                    if historico:
                        ganhador = random.choice(historico)
                        print('\nEncerrando o sistema...')
                        print(f'O item sorteado da rodada, baseado na movimentação de estoque foi [{ganhador}]!')
                        break
            elif verificacao == "N":
                break

    elif opcao == 3:
        print("\n--- HISTÓRICO DE RETIRADAS ---")
        if len(historico) == 0:
            print("Nenhuma retirada realizada ainda.")
        else:
            print(f'Os itens retirados e suas quantidades até o momento foram: {historico}.')
            break

    if opcao == 4:
        print('Encerrando programa...')
        break
    elif opcao == 5:
        repor_estoque()
        continue
    elif opcao == 6:
        cadastrar_produto()
        continue
    elif opcao == 7:
        buscar_produto()
        continue
    elif opcao == 8:
        estoque_baixo()
        continue
    elif opcao == 9:
        relatorio()
        continue
        